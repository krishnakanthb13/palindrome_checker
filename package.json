{
  "name": "palindrome_checker_orchestrator",
  "version": "3.0.0",
  "private": true,
  "description": "Palindrome Checker App",
  "license": "GPL-3.0-only",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --kill-others --raw \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server --silent",
    "dev:client": "npm run dev --workspace=client --silent",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js",
    "preview": "npm run preview --workspace=client",
    "test": "node --test tests/analysis.test.mjs tests/api.test.mjs tests/encoding.test.mjs tests/search.test.mjs tests/server.test.mjs",
    "lint": "npm run lint --workspace=client",
    "clean": "node scripts/clean-caches.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
